ue="9" Name="NCS" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="RearSealWashPump" Level="Advanced" Description="Displays the status of the rear seal washing pump. One can explicitly initiate a pumping interval or stopping a running pumping interval by setting RearSealWashingPump to 'Active'/'Idle', respectively. Note: It is not possible to deactivate the washing pump permanently." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Idle" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Active" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="RearSealWashStatus" Level="Normal" Description="Displays whether the rear seal washing system is operational or has run out of liquid ('Dry'). In the latter case, add rear seal washing liquid as soon as possible." Read-Only="true" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Dry" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Operational" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Leak" Level="Normal" Description="Displays the current status of the leak sensor." Read-Only="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NoLeak" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Leak" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="SolventRackLeak" Level="Normal" Description="Displays the status of the leak sensor in the solvent rack." Read-Only="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NoLeak" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Leak" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="LeakSensorMode" Level="Normal" Description="Enables or disables the leak detection handling. If leak detection is disabled (not recommended in normal operation) the pump will still show the status of the leak sensor but not longer issuing a leak alert." Read-Only="false" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Disabled" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Enabled" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="RearSealLeakCurrent" Level="Service" Description="Displays the number of counted drops since the latest back washing procedure." Read-Only="true" Type="int" Min="0" Max="1000000" Unit="" Value="0" /&amp;gt;&amp;lt;Property Name="RearSealLeakCounter" Level="Service" Description="Displays the number of counted drops per hour since the latest back washing procedure." Read-Only="true" Type="float" Digits="2" Min="0.00" Max="1000000.00" Unit="Drops/h" Value="0.00" /&amp;gt;&amp;lt;Property Name="OverrideRearSealDry" Level="Expert" Description="If set to 'Enabled', one can start a queue or set a flow even if the RearSealStatus reports 'Dry'. Note: This parameter will be set to 'Disabled' automatically after each rear seal washing cycle." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Disabled" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Enabled" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Degasser" Level="Expert" Description="Switches the degasser on or off. Note: The degasser should be switched off only in exceptional cases." Read-Only="false" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="DegasserVacuum" Level="Advanced" Description="Displays the status of the degasser vacuum." Read-Only="true" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NotOK" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="OK" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="DegasserPressure" Level="Service" Description="Displays the remaining pressure of the degasser vacuum." Read-Only="true" Type="int" Min="0" Max="150000" Unit="Pa" Value="0" /&amp;gt;&amp;lt;Property Name="DegasserMotorRPM" Level="Service" Description="Displays the revolutions per minute of the vacuum pump motor." Read-Only="true" Type="int" Min="0" Max="100000" Unit="rpm" Value="0" /&amp;gt;&amp;lt;Property Name="DegasserCategory" Level="Service" Description="Only for internal purposes: This property is 1 if the new degasser type is installed and online, it is 0 in all other cases." Read-Only="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="1" /&amp;gt;&amp;lt;Enum-Value Value="0" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Ready" Level="Normal" Description="Indicates that the module is ready for the next injection." Read-Only="true" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NotReady" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Ready" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Alarm" Level="Normal" Description="Indicates whether the pump reports an alarm (e.g. leak detected, low/high pressure failure). The pump won't clear an alarm state automatically. One can reset the 'Alarm' status by calling 'AlarmOff'." Read-Only="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Command Name="AlarmOff" Level="Normal" Description="Resets the alarm state in the pump. The command has no effect if the alarm state is 'Off'." /&amp;gt;&amp;lt;Command Name="ClearDisplayError" Level="Advanced" Description="Clears any error messages displayed on the module's display." /&amp;gt;&amp;lt;Property Name="Standby" Level="Advanced" Description="The device's standby state." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NoStandby" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Standby" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="WakingUp" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="EnteringStandby" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Command Name="SetFactoryDefaults" Level="Expert" Description="Sets internal parameters to factory defaults." /&amp;gt;&amp;lt;Property Name="Brightness" Level="Advanced" Description="Sets the display's brightness." Read-Only="false" Type="int" Min="0" Max="100" Unit="%" Value="71" /&amp;gt;&amp;lt;Property Name="Contrast" Level="Advanced" Description="Sets the display's contrast." Read-Only="false" Type="int" Min="0" Max="100" Unit="%" Value="24" /&amp;gt;&amp;lt;Property Name="FirmwareVersion" Level="Expert" Description="The module's firmware version." Read-Only="true" Type="string" Max-Length="9" Value="3.44" /&amp;gt;&amp;lt;Property Name="FPGAVersion" Level="Expert" Description="The module's FPGA version." Read-Only="true" Type="string" Max-Length="9" Value="00.42" /&amp;gt;&amp;lt;Property Name="SerialNo" Level="Expert" Description="The serial number of the module." Read-Only="true" Type="string" Max-Length="16" Value="8105655" /&amp;gt;&amp;lt;Property Name="MainBoardRevision" Level="Expert" Description="Displays the mainboard revision of the connected device." Read-Only="true" Type="int" Min="0" Max="1000000" Unit="" Value="2" /&amp;gt;&amp;lt;Property Name="DriverID" Level="Expert" Description="Unique Driver Identifier." Read-Only="true" Type="string" Max-Length="20" Value="Dionex.PumpLPG3X00RS" /&amp;gt;&amp;lt;Device Name="QuatPump" Level="Normal" Description="" Type="general"&amp;gt;&amp;lt;Property Name="Motor" Level="Advanced" Description="Switches the motors on/off." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Struct Name="Flow" Level="Normal" Description="Total flow through the pump."&amp;gt;&amp;lt;Property Name="Nominal" Level="Normal" Description="Sets and displays the nominal value of this parameter." Read-Only="false" LDefault="true" Type="float" Digits="3" Min="0.000" Max="8.000" Unit="ml/min" Gradient="true" Value="0.000" /&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="Displays the actual value of this parameter." Read-Only="true" RDefault="true" Type="float" Digits="3" Min="0.000" Max="8.000" Unit="ml/min" Gradient="true" Value="0.000" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Struct Name="%A" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow." Read-Only="true" RDefault="true" Type="float" Digits="1" Min="0.0" Max="100.0" Unit="%" Value="51.1" /&amp;gt;&amp;lt;Property Name="Equate" Level="Normal" Description="User-selectable designation of this solvent component." Read-Only="false" Type="string" Max-Length="64" Value="%A" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Struct Name="%B" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow." Read-Only="false" LDefault="true" RDefault="true" Type="float" Digits="1" Min="0.0" Max="100.0" Unit="%" Gradient="true" Value="48.9" /&amp;gt;&amp;lt;Property Name="Equate" Level="Normal" Description="User-selectable designation of this solvent component." Read-Only="false" Type="string" Max-Length="64" Value="%B" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Struct Name="%C" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow." Read-Only="false" LDefault="true" RDefault="true" Type="float" Digits="1" Min="0.0" Max="100.0" Unit="%" Gradient="true" Value="0.0" /&amp;gt;&amp;lt;Property Name="Equate" Level="Normal" Description="User-selectable designation of this solvent component." Read-Only="false" Type="string" Max-Length="64" Value="%C" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Struct Name="%D" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="Partial flow of this component, expressed in percent of the total flow." Read-Only="false" LDefault="true" RDefault="true" Type="float" Digits="1" Min="0.0" Max="100.0" Unit="%" Gradient="true" Value="0.0" /&amp;gt;&amp;lt;Property Name="Equate" Level="Normal" Description="User-selectable designation of this solvent component." Read-Only="false" Type="string" Max-Length="64" Value="%D" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Property Name="Curve" Level="Normal" Description="Specifies the curve number used for gradients. 1-4 represent convex curves (descending curvature with ascending number), 5=linear, 6-9 concave (ascending curvature with ascending number). See help for more details." Read-Only="false" Type="int" Min="1" Max="9" Unit="" Gradient="true" Value="5" /&amp;gt;&amp;lt;Struct Name="Pressure" Level="Normal" Description="The current pump pressure."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="The current pump pressure." Read-Only="true" RDefault="true" Type="int" Min="0" Max="650" Unit="bar" Value="0" /&amp;gt;&amp;lt;Property Name="LowerLimit" Level="Normal" Description="The pump will stop the flow when the pressure falls below this value for a given time span, see also LowerLimitGracePeriod" Read-Only="false" Type="int" Min="0" Max="650" Unit="bar" Value="0" /&amp;gt;&amp;lt;Property Name="UpperLimit" Level="Normal" Description="The pump will stop the flow when the pressure exceeds this value" Read-Only="false" Type="int" Min="0" Max="650" Unit="bar" Value="750" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Property Name="Ready" Level="Normal" Description="Indicates that the module is ready for the next injection." Read-Only="true" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NotReady" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Ready" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="MaximumFlowRampUp" Level="Advanced" Description="The maximum flowrate acceleration (increasing flow)." Read-Only="false" Type="float" Digits="3" Min="0.001" Max="9999.999" Unit="ml/min²" Value="6.000"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Infinite" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="MaximumFlowRampDown" Level="Advanced" Description="The maximum flowrate acceleration (decreasing flow)." Read-Only="false" Type="float" Digits="3" Min="0.001" Max="9999.999" Unit="ml/min²" Value="5.998"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Infinite" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Purge" Level="Normal" Description="Specifies whether the pump is in purge mode. 'Purge=On' starts a purge run. 'Purge=Off' cancels a purge run. A purge run will stop automatically after a time span given by 'PurgeTime'. See also 'PurgeTime' and 'PurgeFlow'." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="PurgeTime" Level="Advanced" Description="Specifies the time of a purge run. After this time has been elapsed the pump switches back to normal operation. Note: One may cancel a purge run explicitly by sending Purge=Off." Read-Only="false" Type="int" Min="0" Max="3600" Unit="s" Value="300" /&amp;gt;&amp;lt;Property Name="PurgeFlow" Level="Advanced" Description="Specifies the flow to be pumped during the purge run." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="8.000" Unit="ml/min" Value="3.000" /&amp;gt;&amp;lt;Property Name="FlowMode" Level="Expert" Description="Displays the current flow mode of the pump. Read-only. For internal services only." Read-Only="true" Type="int" Min="0" Max="3" Unit="" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="StopFlowHold" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="StopFlow" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Hold" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="Running" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="PurgeHold" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="Purge" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="Park" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="StaticMixer" Level="Expert" Description="Displays and sets the installed static mixer unit. This value is used by some diagnostic tests and must be set correctly once before starting a diagnostic test." Read-Only="false" Type="int" Min="-1" Max="6" Unit="" Value="3"&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="75ul" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="150ul" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="350ul" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="750ul" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="1500ul" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="InlineFilter_10ul" /&amp;gt;&amp;lt;Enum-Value Value="-1" Name="Unknown" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="ModelNo" Level="Expert" Description="Model number." Read-Only="true" Type="string" Max-Length="11" Value="LPG-3400RS" /&amp;gt;&amp;lt;Property Name="ModelVariant" Level="Normal" Description="Displays the model variant of the pump device (Unknown, Isocratic, LPG, HPG, DGP, DP, NCP_32 and NCS_35)." Read-Only="true" Type="int" Min="0" Max="5" Unit="" Value="2"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Unknown" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Isocratic" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="LPG" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="HPG" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="DGP" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="DP" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="NCP_32" /&amp;gt;&amp;lt;Enum-Value Value="7" Name="NCS_35" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="SerialNo" Level="Service" Description="The serial number of the module." Read-Only="true" Type="string" Max-Length="16" Value="8105655" /&amp;gt;&amp;lt;Struct Name="%A_Level" Level="Normal" Description="The remaining amount of this eluent in this bottle."&amp;gt;&amp;lt;Property Name="Value" Leve