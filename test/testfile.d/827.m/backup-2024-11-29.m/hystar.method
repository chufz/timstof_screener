er frit' test proecdure."&amp;gt;&amp;lt;Parameter Name="Eluent" Description="This parameter defines which eluent is to be used during the 'Mixer frit' test procedure. This should be pure degassed water." Optional="false" ByName="false" Type="int" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="%A" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="%B" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="%C" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="%D" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="MixerFrit_EndTest" Level="Service" Description="This command ends the 'Mixer frit' test procedure." /&amp;gt;&amp;lt;Command Name="MixerFrit_AbortTest" Level="Service" Description="This command aborts a running  'Mixer frit' test procedure." /&amp;gt;&amp;lt;Property Name="MixerFrit_TestResult" Level="Service" Description="This property displays the result of the most recent 'Mixer frit' test procedure." Read-Only="false" Type="int" Min="0" Max="5" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Unknown" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Running" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Success" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="SuccessWithLimitation" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Failure" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="Aborted" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="MixerFrit_TestStage" Level="Service" Description="This property displays the current status of the 'Mixer frit' test procedure." Read-Only="false" Type="int" Min="0" Max="255" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NotRunning" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="PleaseDisconnectFluidics" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="BuildingUpPressure" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="FlowStopped" /&amp;gt;&amp;lt;Enum-Value Value="254" Name="Finished" /&amp;gt;&amp;lt;Enum-Value Value="255" Name="Aborted" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Command