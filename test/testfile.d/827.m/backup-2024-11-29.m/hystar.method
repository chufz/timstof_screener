ype="float" Digits="1" Min="0.0" Max="30.0" Unit="min" Value="0.5"&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="ReadyTempDelta" Level="Expert" Description="Instrument will enter NotReady state if the difference between current temperature and setpoint exceeds this value. If the ReadyTempDelta is set to 'None', the system does not check whether the temperature set point deviates from the current temperature." Read-Only="false" Type="float" Digits="1" Min="0.0" Max="5.0" Unit="°C" Value="1.0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Struct Name="Temperature" Level="Normal" Description="The current temperature of the oven."&amp;gt;&amp;lt;Property Name="Value" Level="Normal" Description="The current temperature of the oven." Read-Only="true" RDefault="true" Type="float" Digits="1" Min="5.0" Max="80.0" Unit="°C" Value="40.0" /&amp;gt;&amp;lt;Property Name="Nominal" Level="Normal" Description="The requested temperature setting for the oven." Read-Only="false" LDefault="true" Type="float" Digits="1" Min="5.0" Max="80.0" Unit="°C" Value="40.0" /&amp;gt;&amp;lt;Property Name="UpperLimit" Level="Advanced" Description="Limit for the parameter value. For critical parameters like pressure the system may abort the injection queue and start emergency handling if the value is outside these limits." Read-Only="false" Type="float" Digits="1" Min="5.0" Max="80.0" Unit="°C" Value="45.0" /&amp;gt;&amp;lt;Property Name="LowerLimit" Level="Advanced" Description="Limit for the parameter value. For critical parameters like pressure the system may abort the injection queue and start emergency handling if the value is outside these limits." Read-Only="false" Type="float" Digits="1" Min="5.0" Max="80.0" Unit="°C" Value="35.0" /&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Command Name="CmdString" Level="Service" Description="This command allows to send arbitrary commands to the module's firmw