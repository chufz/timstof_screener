for internal use only." Read-Only="false" Type="float" Digits="2" Min="0.00" Max="120.00" Unit="%" Value="28.54" /&amp;gt;&amp;lt;Property Name="WorkLoad" Level="Normal" Description="Displays the total workload of this pump block since it was installed." Read-Only="true" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Value="3.506" /&amp;gt;&amp;lt;Property Name="SupportRingChangeDate" Level="Expert" Description="Displays the date of the last exchange of the referring component (Format: Year - Month - Day)." Read-Only="true" Type="string" Max-Length="12" Value="2015-08-13" /&amp;gt;&amp;lt;Struct Name="SupportRingWorkload" Level="Normal" Description="Displays the workload of the support rings by monitoring the pump strokes of this head. Also handles the referring service counter. Value refers to the number of strokes since the latest change."&amp;gt;&amp;lt;Property Name="Value" Level="Expert" Description="Displays the workload of the support rings by monitoring the pump strokes of this head. Also handles the referring service counter. Value refers to the number of strokes since the latest change." Read-Only="true" RDefault="true" Type="int" Min="0" Max="2147483648" Unit="" Performance-Counter-Direction="Up" Value="1629039" /&amp;gt;&amp;lt;Property Name="Warning" Level="Expert" Description="System issues a warning when the associated counter reaches this value." Read-Only="false" Type="int" Min="0" Max="2147483648" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Limit" Level="Expert" Description="System issues an error when the associated counter reaches this value." Read-Only="false" Type="int" Min="0" Max="2147483648" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Command Name="SupportRingChanged" Level="Normal" Description="Execute this command after the support rings of this pump head has been changed. The referring counter will be reset." /&amp;gt;&amp;lt;Struct Name="CheckValveService" Level="Expert" Description="Displays the date of the most recent check of the valve. Also controls the service interval counter of this component."&amp;gt;&amp;lt;Property Name="LastDate" Level="Expert" Description="Displays the date of the most recent check of the valve. Also controls the service interval counter of this component." Read-Only="true" RDefault="true" Type="string" Max-Length="12" Value="2022-03-01" /&amp;gt;&amp;lt;Property Name="WarningPeriod" Level="Expert" Description="System will issue a warning within the specified period reminding the user of the next due date for re-qualification." Read-Only="false" Type="int" Min="0" Max="3650" Unit="d" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Interval" Level="Expert" Description="Interval after which a service of the module is due." Read-Only="false" Type="int" Min="0" Max="3650" Unit="d" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Command Name="CheckValveServiceDone" Level="Normal" Description="Call this command after the service actions at the valve has been performed." /&amp;gt;&amp;lt;Property Name="PistonChangeDate" Level="Expert" Description="Displays the date of the last exchange of the referring component (Format: Year - Month - Day)." Read-Only="true" Type="string" Max-Length="12" Value="2024-04-22" /&amp;gt;&amp;lt;Struct Name="PistonWorkload" Level="Normal" Description="Displays the current piston workload and handles the referring service counter. Values are in MJ."&amp;gt;&amp;lt;Property Name="Value" Level="Expert" Description="Displays the current piston workload and handles the referring service counter. Values are in MJ." Read-Only="true" RDefault="true" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Performance-Counter-Direction="Up" Value="0.125" /&amp;gt;&amp;lt;Property Name="Warning" Level="Expert" Description="System issues a warning when the associated counter reaches this value." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Value="0.000"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Limit" Level="Expert" Description="System issues an error when the associated counter reaches this value." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Value="0.000"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Command Name="PistonsChanged" Level="Normal" Description="Execute this command after the pistons of this pump head has been changed. The referring counter will be reset." /&amp;gt;&amp;lt;Property Name="SealChangeDate" Level="Expert" Description="Displays the date of the last exchange of the referring component (Format: Year - Month - Day)." Read-Only="true" Type="string" Max-Length="12" Value="2024-04-22" /&amp;gt;&amp;lt;Struct Name="SealWorkload" Level="Normal" Description="Displays the current seal workload and handles the referring service counter. Values are in MJ."&amp;gt;&amp;lt;Property Name="Value" Level="Expert" Description="Displays the current seal workload and handles the referring service counter. Values are in MJ." Read-Only="true" RDefault="true" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Performance-Counter-Direction="Up" Value="0.125" /&amp;gt;&amp;lt;Property Name="Warning" Level="Expert" Description="System issues a warning when the associated counter reaches this value." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Value="0.000"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Limit" Level="Expert" Description="System issues an error when the associated counter reaches this value." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="10000.000" Unit="MJ" Value="0.000"&amp;gt;&amp;lt;Enum-Value Value="0.000" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Struct&amp;gt;&amp;lt;Command Name="SealChanged" Level="Normal" Description="Execute this command after the seal of this pump head has been changed. The referring counter will be reset." /&amp;gt;&amp;lt;Command Name="UndockPistons" Level="Expert" Description="This command moves the pistons of this pump head in a position suitable for exchange of the pistons or the seal. Wait until 'PistonPositionStatus' reports 'Undocked', before changing the pistons /seal. After maintenance, call the 'DockPistons' command and wait until 'PistonPositionStatus' reports 'Operational'." /&amp;gt;&amp;lt;Command Name="DockPistons" Level="Expert" Description="This command moves the pistons of this pump head back into a position that allows normal operation. Wait until 'PistonPositionStatus' reports 'Operational', then proceed with normal operation." /&amp;gt;&amp;lt;Property Name="PistonPositionStatus" Level="Expert" Description="Displays the position status of the pistons of this pump head. Default value is 'Operational'. If value is 'Undocked' one can change the pistons of this pump head. Other values ('PrepareUndocking', 'PrepareDocking', 'Lubricating') represent temporary states, indicating the device is busy. See also 'UndockPistons' and 'DockPistons'." Read-Only="true" Type="int" Min="0" Max="255" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Operational" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="PrepareUndocking" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Undocked" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="PrepareDocking" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Lubricating" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="ErrorUndock" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="ErrorDock" /&amp;gt;&amp;lt;Enum-Value Value="7" Name="ErrorLubricating" /&amp;gt;&amp;lt;Enum-Value Value="8" Name="AutoLubricating" /&amp;gt;&amp;lt;Enum-Value Value="255" Name="Unknown" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;Device Name="QuatPump_Diagnostics" Level="Service" Description="Diagnostic commands and properties." Type="general"&amp;gt;&amp;lt;Property Name="DiagnosticComment" Level="Service" Description="comment about performing a diagnostic test. For reporting purposes only." Read-Only="false" Type="string" Max-Length="255" Value="" /&amp;gt;&amp;lt;Command Name="External_StartTest" Level="Service" Description="This command starts the 'External' test proecdure."&amp;gt;&amp;lt;Parameter Name="Eluent" Description="This parameter defines which eluent is to be used during the 'External' test procedure. This should be pure degassed water." Optional="false" ByName="false" Type="int" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="%A" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="%B" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="%C" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="%D" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="UpperPressure" Description="This parameter defines an upper pressure limit to be used during the 'External' test procedure." Optional="true" ByName="false" Type="int" Min="0" Max="1034" Unit="bar" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="External_EndTest" Level="Service" Description="This command ends the 'External' test procedure." /&amp;gt;&amp;lt;Command Name="External_AbortTest" Level="Service" Description="This command aborts a running  'External' test procedure." /&amp;gt;&amp;lt;Property Name="External_TestResult" Level="Service" Description="This property displays the result of the most recent 'External' test procedure." Read-Only="false" Type="int" Min="0" Max="5" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Unknown" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Running" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Success" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="SuccessWithLimitation" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Failure" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="Aborted" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="External_TestStage" Level="Service" Description="This property displays the current status of the 'External' test procedure." Read-Only="false" Type="int" Min="0" Max="255" Unit="" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="NotRunning" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Running" /&amp;gt;&amp;lt;Enum-Value Value="254" Name="Finished" /&amp;gt;&amp;lt;Enum-Value Value="255" Name="Aborted" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Command Name="External_SuppressRC" Level="Service" Description="Used internally during diagnostic tests to suppress ready check warnings. Do not use during normal operation!" /&amp;gt;&amp;lt;Command Name="GeneralLeak_StartTest" Level="Service" Description="This command starts the 'General Leak' test proecdure."&amp;gt;&amp;lt;Parameter Name="Eluent" Description="This parameter defines which eluent is to be used during the 'General Leak' test procedure. This should be pure degassed water." Optional="false" ByName="false" Type="int" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="%A" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="%B" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="%C" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="%D" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="PumpBlock" Description="This parameter defines which pumpblock is to be tested during the 'General Leak' test procedure." Optional="false" ByName="false" Type="int" Min="0" Max="2" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="Left" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Left" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Right" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="UpperPressure" Description="This parameter defines an upper pressure limit to be used during the 'General Leak' test proc