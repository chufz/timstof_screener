mp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Volume" Level="Normal" Description="The injection volume." Read-Only="false" Type="float" Digits="3" Min="0.001" Max="100.000" Unit="µl" Value="100.000" /&amp;gt;&amp;lt;Command Name="Reset" Level="Normal" Description="Resets the device to its initial condition, as attained after power-up." /&amp;gt;&amp;lt;Property Name="Connected" Level="Advanced" Description="Indicates whether the device is connected to the data system, i.e. under computer control. &amp;amp;#xD;&amp;amp;#xA;See also: Connect, Disconnect." Read-Only="false" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Disconnected" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Connected" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Command Name="Disconnect" Level="Advanced" Description="Disconnects the device from the data system, enables manual control from the device's front panel. &amp;amp;#xD;&amp;amp;#xA;See also: Connected, Connect." /&amp;gt;&amp;lt;Command Name="Connect" Level="Advanced" Description="Connects the device to the data system, enables computer control. &amp;amp;#xD;&amp;amp;#xA;See also: Connected, Disconnect." /&amp;gt;&amp;lt;Device Name="Input_1" Level="Normal" Description="Digital Input." Type="general"&amp;gt;&amp;lt;Property Name="State" Level="Normal" Description="Indicates the input's state." Read-Only="true" RDefault="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;Device Name="Relay_1" Level="Normal" Description="Relay." Type="general"&amp;gt;&amp;lt;Property Name="State" Level="Normal" Description="Indicates (or sets) the relay's state." Read-Only="false" LDefault="true" RDefault="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Duration" Level="Normal" Description="When set, the relay's state will toggle after the specified time." Read-Only="false" Type="float" Digits="2" Min="0.00" Max="59999.90" Unit="s" Value="0.00" /&amp;gt;&amp;lt;Command Name="On" Level="Normal" Description="Turns the relay on."&amp;gt;&amp;lt;Parameter Name="Duration" Description="When specified, the relay will return to its previous state after the specified time." Optional="true" ByName="false" Type="float" Digits="2" Min="0.00" Max="59999.90" Unit="s" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="Off" Level="Normal" Description="Turns the relay off."&amp;gt;&amp;lt;Parameter Name="Duration" Description="When specified, the relay will return to its previous state after the specified time." Optional="true" ByName="false" Type="float" Digits="2" Min="0.00" Max="59999.90" Unit="s" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;Device Name="System" Level="Normal" Description="The &amp;amp;quot;System&amp;amp;quot; device contains commands and properties for the entire instrument. &amp;amp;#xD;&amp;amp;#xA;It is always available and can't be seen in Chromeleon Instrument Configuration Manager." Type="general"&amp;gt;&amp;lt;Command Name="WriteReportMacro" Level="Service" Description="Writes a report macro definition to the audit trail."&amp;gt;&amp;lt;Parameter Name="Name" Description="Name of the report macro. At dedicated places in report definition files, this name (preceded by a dollar character) will be replaced by the value text." Optional="false" ByName="false" Type="string" Max-Length="63" /&amp;gt;&amp;lt;Parameter Name="Value" Description="Value of the report macro. At dedicated places in report definition files, the macro name (preceded by a dollar character) will be replaced by this text." Optional="false" ByName="false" Type="string" Max-Length="255" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="PlotMarker" Level="Service" Description="Adds a chromatogram or spectrum plot marker to the audit trail."&amp;gt;&amp;lt;Parameter Name="MarkerString" Description="Description of the plot marker." Optional="true" ByName="false" Type="string" Max-Length="255" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="RespondToMessage" Level="Expert" Description="If a Message command is currently executing, indicate that the user has clicked &amp;amp;quot;OK&amp;amp;quot;. (This command is automatically used by the system, and should not be used normally)"&amp;gt;&amp;lt;Parameter Name="MessageID" Description="If a Message command is currently executing, the internal id of the message." Optional="false" ByName="false" Type="int" Min="-2147483648" Max="2147483648" Unit="" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Property Name="MessageID" Level="Expert" Description="If a Message command is currently executing, the internal id of the message." Read-Only="true" Type="int" Min="-2147483648" Max="2147483648" Unit="" Value="" /&amp;gt;&amp;lt;Property Name="MessageText" Level="Expert" Description="If a Message command is currently executing, the message text." Read-Only="true" Type="string" Max-Length="255" Value="" /&amp;gt;&amp;lt;Property Name="DiagnosticTestName" Level="Expert" Description="The current diagnostic test name." Read-Only="true" Type="string" Max-Length="127" Value="" /&amp;gt;&amp;lt;Property Name="CurrentStage" Level="Expert" Description="The current instrument method stage." Read-Only="true" Type="string" Max-Length="127" Value="" /&amp;gt;&amp;lt;Property Name="TotalFluidics" Level="Service" Description="Represents the current fluidic setup of the instrument." Read-Only="true" Type="string" Max-Length="16384" Value="&amp;amp;lt;Fluidics&amp;amp;gt;&amp;amp;lt;/Fluidics&amp;amp;gt;" /&amp;gt;&amp;lt;Property Name="Fluidics" Level="Service" Description="Represents the current fluidic setup of the instrument." Read-Only="false" Type="string" Max-Length="8192" Value="&amp;amp;lt;Fluidics&amp;amp;gt;&amp;amp;lt;/Fluidics&amp;amp;gt;" /&amp;gt;&amp;lt;Command Name="Sound" Level="Normal" Description="Plays a sound (on the instrument controller). &amp;amp;#xD;&amp;amp;#xA;Note: Not supported on Windows XP (64 bit), Windows Vista and Windows 7."&amp;gt;&amp;lt;Parameter Name="File" Description="The name of the sound file (*.wav, usually found in the Windows directory). &amp;amp;#xD;&amp;amp;#xA;If no parameters are specified, all sounds stop. &amp;amp;#xD;&amp;amp;#xA;Note: Not supported on Windows XP (64 bit), Windows Vista and Windows 7." Optional="true" ByName="false" Type="string" Max-Length="260" /&amp;gt;&amp;lt;Parameter Name="Frequency" Description="The frequency of a sound to play. &amp;amp;#xD;&amp;amp;#xA;If no parameters are specified, all sounds stop. &amp;amp;#xD;&amp;amp;#xA;Note: Not supported on Windows XP (64 bit), Windows Vista and Windows 7." Optional="true" ByName="false" Type="int" Min="37" Max="20000" Unit="Hz" /&amp;gt;&amp;lt;Parameter Name="Duration" Description="The duration of a sound to play. &amp;amp;#xD;&amp;amp;#xA;If no parameters are specified, all sounds stop. &amp;amp;#xD;&amp;amp;#xA;Note: Not supported on Windows XP (64 bit), Windows Vista and Windows 7." Optional="true" ByName="false" Type="int" Min="0" Max="100" Unit="s" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="ConsumableChanged" Level="Normal" Description="Record a consumable change event."&amp;gt;&amp;lt;Parameter Name="Comment" Description="Enter a comment for this event." Optional="true" ByName="false" Type="string" Max-Length="64" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="EluentChanged" Level="Normal" Description="Record an eluent change event."&amp;gt;&amp;lt;Parameter Name="Comment" Description="Enter a comment for this event." Optional="true" ByName="false" Type="string" Max-Length="64" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="AbortInjection" Level="Normal" Description="Terminates data acquisition and aborts the current injection. &amp;amp;#xD;&amp;amp;#xA;The queue processing continues with the next injection." /&amp;gt;&amp;lt;Command Name="AbortQueue" Level="Normal" Description="Terminates data acquisition and aborts the current sequence queue run." /&amp;gt;&amp;lt;Command Name="StopFlow" Level="Normal" Description="Enter stop mode." /&amp;gt;&amp;lt;Command Name="Hold" Level="Normal" Description="Enter hold mode." /&amp;gt;&amp;lt;Command Name="Continue" Level="Normal" Description="End hold mode." /&amp;gt;&amp;lt;Command Name="AcqOff" Level="Normal" Description="End data acquisition on all channels." /&amp;gt;&amp;lt;Command Name="AcqOn" Level="Normal" Description="Turn acquisition on for all installed and initialized channels." /&amp;gt;&amp;lt;Command Name="StartManualAcquisition" Level="Service" Description="Starts baseline monitoring." /&amp;gt;&amp;lt;Property Name="LicenseMode" Level="Expert" Description="Indicates the license mode." Read-Only="true" Type="int" Min="0" Max="5" Unit="" Value="3"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Unknown" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Standard" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="NFP" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="Demo" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="GracePeriod" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="Interim" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="LicenseServerNFPMode" Level="Expert" Description="&amp;amp;quot;On&amp;amp;quot; if the License Server could not be reached due to network problems. &amp;amp;#xD;&amp;amp;#xA;This Instrument Controller is using a locally cached license." Read-Only="true" Type="bool" Value="0"&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="RequiredLicenseClass" Level="Service" Description="Indicates the required license class for this instrument." Read-Only="true" Type="float" Digits="1" Min="0.0" Max="3.0" Unit="" Value="1.0"&amp;gt;&amp;lt;Enum-Value Value="0" Name="0" /&