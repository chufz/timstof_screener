rue" Type="string" Max-Length="129" Value="" /&amp;gt;&amp;lt;Property Name="Sequence" Level="Normal" Description="The sequence name (without path)." Read-Only="true" Type="string" Max-Length="129" Value="" /&amp;gt;&amp;lt;Property Name="Type" Level="Normal" Description="The injection type (standard, unknown...)." Read-Only="true" Type="int" Min="0" Max="8" Unit="" Value="9"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Unknown" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="BlankRun" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="CheckStandard" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="CalibrationStandard" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="Bracket" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="Matrix" /&amp;gt;&amp;lt;Enum-Value Value="7" Name="Spiked" /&amp;gt;&amp;lt;Enum-Value Value="8" Name="Unspiked" /&amp;gt;&amp;lt;Enum-Value Value="9" Name="n/a" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="Number" Level="Normal" Description="The injection number." Read-Only="true" Type="int" Min="0" Max="9999" Unit="" Value="" /&amp;gt;&amp;lt;Property Name="GUID" Level="Advanced" Description="The globally unique ID of the injection run." Read-Only="true" Type="string" Max-Length="37" Value="" /&amp;gt;&amp;lt;Property Name="ID" Level="Expert" Description="The internal injection identification (unique in the sequence, never changing)." Read-Only="true" Type="string" Max-Length="37" Value="" /&amp;gt;&amp;lt;Property Name="Comment" Level="Normal" Description="The injection comment." Read-Only="true" Type="string" Max-Length="256" Value="" /&amp;gt;&amp;lt;Property Name="Name" Level="Normal" Description="The injection name." Read-Only="true" RDefault="true" Type="string" Max-Length="129" Value="" /&amp;gt;&amp;lt;Property Name="URL" Level="Expert" Description="The full internal designation of the injection." Read-Only="true" Type="string" Max-Length="2048" Value="" /&amp;gt;&amp;lt;Property Name="LocalURL" Level="Service" Description="The full local path of the injection. This is the URL in the XVault if the injection is downloaded." Read-Only="true" Type="string" Max-Length="2048" Value="" /&amp;gt;&amp;lt;Device Name="CustomVariables" Level="Normal" Description="Custom Variables" Type="general" DynamicContent="true" /&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;/Device&amp;gt;&amp;lt;Command Name="Log" Level="Normal" Description="Writes any device property to the audit trail. Use this to document measured conditions, for example temperature, without using an A/D channel."&amp;gt;&amp;lt;Parameter Name="Property" Description="The name of the property which you want to write to the audit trail." Optional="false" ByName="false" Type="reference" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="Message" Level="Normal" Description="Shows a message to the operator, and waits until the operator clicks OK. Stops the instrument method time, the pump is in 'Hold' mode. But the acquisition is not stopped."&amp;gt;&amp;lt;Parameter Name="Text" Description="To message which you want to display, e.g. &amp;amp;quot;Make sure all vials are in their correct position&amp;amp;quot;. It will be written to the audit trail, too." Optional="false" ByName="false" Type="string" Max-Length="250" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="Protocol" Level="Normal" Description="Write an arbitrary message to the audit trail, e.g. experimental conditions you want to document."&amp;gt;&amp;lt;Parameter Name="Text" Description="The message which you want to write to the audit trail." Optional="false" ByName="false" Type="string" Max-Length="250" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="Wait" Level="Normal" Description="Interrupt the instrument method until the condition changes from &amp;amp;quot;false&amp;amp;quot; to &amp;amp;quot;true&amp;amp;quot;. 'Wait' stops the instrument method time, the pump is in 'Hold' mode. But the acquisition is not stopped."&amp;gt;&amp;lt;Parameter Name="Condition" Description="The condition, when to resume instrument method execution. You can specify an input name or use expressions like (Input_1 AND NOT Input_2) OR (Pressure &amp;amp;gt; 40)." Optional="false" ByName="false" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="0" Name="False" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="True" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Run" Description="Whether retention time and gradients should be on hold or continue during the Wait command. (Default: Hold)" Optional="true" ByName="false" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Continue" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Hold" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Timeout" Description="The maximum time to wait for the condition to become true. If this time is exceeded, the injection will abort. (Default: Infinite)" Optional="true" ByName="true" Type="float" Digits="2" Min="0.10" Max="1440.00" Unit="min"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Infinite" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="Delay" Level="Advanced" Description="Delays the execution of the following commands for the given time. Normally used only in triggers."&amp;gt;&amp;lt;Parameter Name="Delay" Description="Delays the execution of the following commands for the given time. Normally used only in triggers." Optional="false" ByName="false" Type="float" Digits="1" Min="0.0" Max="1000000.0" Unit="s" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="VirtualChannel" Level="Expert" Description="Create a virtual channel and start the acquisition."&amp;gt;&amp;lt;Parameter Name="Name" Description="The name of the virtual channel. It must be unique and different to any signal name." Optional="false" ByName="false" Type="string" Max-Length="127" /&amp;gt;&amp;lt;Parameter Name="Formula" Description="The numeric expression that should be recorded. You can use formulas like (UV_VIS_1 / 1000) / (ColumnOven.Temperature * 10)." Optional="false" ByName="false" Type="float" Digits="6" Min="-100000002004088000000.000000" Max="100000002004088000000.000000" Unit="" /&amp;gt;&amp;lt;Parameter Name="Type" Description="The type of the virtual channel: &amp;amp;#xD;&amp;amp;#xA;- Use Analog (the default) to record a continuous curve like a detector signal or a temperature. &amp;amp;#xD;&amp;amp;#xA;- Use Digital if the numeric expression can result only in a few discrete values (e.g. in case of a relay state). The curve will consist of steps." Optional="true" ByName="true" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Analog" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Digital" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Unit" Description="The unit of the virtual channel." Optional="true" ByName="true" Type="string" Max-Length="255" /&amp;gt;&amp;lt;Parameter Name="Evaluate" Description="Indicates whether the signal is evaluated (peak detection and integration). The default is 'No'." Optional="true" ByName="true" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="1" Name="Yes" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="No" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="OnlineExtract" Level="Expert" Description="Create an online extract and start the acquisition."&amp;gt;&amp;lt;Parameter Name="Name" Description="The name of the online extract. It must be unique and different to any signal name." Optional="false" ByName="false" Type="string" Max-Length="127" /&amp;gt;&amp;lt;Parameter Name="TraceType" Description="The trace type that should be used for this online extract." Optional="false" ByName="false" Type="int" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="MassRange" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="TIC" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="BasePeak" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Fragment" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="ScanFilter" Description="The scan filter that should be used for this online extract." Optional="false" ByName="false" Type="string" Max-Length="255" /&amp;gt;&amp;lt;Parameter Name="SmoothingType" Description="The smoothing type that should be used for this online extract." Optional="false" ByName="false" Type="int" Min="0" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="None" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="MovingAverage" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Olympic" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="Gaussian" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="SavitzkyGolay" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="SmoothingRange" Description="The smoothing range that should be used for this online extract. &amp;amp;#xD;&amp;amp;#xA;Must be odd." Optional="true" ByName="true" Type="int" Min="3" Max="999" Unit="" /&amp;gt;&amp;lt;Parameter Name="Unit" Description="The unit of the online extract." Optional="true" ByName="true" Type="string" Max-Length="255" /&amp;gt;&amp;lt;Parameter Name="Evaluate" Description="Indicates whether the signal is evaluated (peak detection and integration). The default is 'No'." Optional="true" ByName="true" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="1" Name="Yes" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="No" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Persist" Description="Indicates whether the signal should be persisted to a data vault. The default is 'No'." Optional="true" ByName="true" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="1" Name="Yes" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="No" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="MinMass" Description="If the ScanFilter contains [MASSRANGE], this part of the filter expression will be replaced by [MinMass-MaxMass]" Optional="true" ByName="true" Type="int" Min="0" Max="9999" Unit="" /&amp;gt;&amp;lt;Parameter Name="MaxMass" Description="If the ScanFilter contains [MASSRANGE], this part of the filter expression will be replaced by [MinMass-MaxMass]" Optional="true" ByNam