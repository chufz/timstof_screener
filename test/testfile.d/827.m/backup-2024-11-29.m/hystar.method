="3" Min="0.010" Max="33.333" Unit="µl/s"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalSpeed" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="SampleHeight" Description="The height at which sample is drawn." Optional="false" ByName="false" Type="float" Digits="3" Min="0.000" Max="40.000" Unit="mm"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalHeight" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Repetitions" Description="Number of Draw/Dispense operations for mixing during sample preparation." Optional="false" ByName="false" Type="int" Min="0" Max="100" Unit="" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpBufferLoopWashAftInj" Level="Advanced" Description="Wash the buffer loop (after inject) during sample preparation."&amp;gt;&amp;lt;Parameter Name="Volume" Description="Volume used for buffer loop wash during sample preparation." Optional="false" ByName="false" Type="float" Digits="3" Min="0.000" Max="5000.000" Unit="µl" /&amp;gt;&amp;lt;Parameter Name="SyringeSpeed" Description="The syringe speed used in draw operations." Optional="false" ByName="false" Type="float" Digits="3" Min="0.010" Max="33.333" Unit="µl/s"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalSpeed" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="SampleHeight" Description="The height at which sample is drawn." Optional="false" ByName="false" Type="float" Digits="3" Min="0.000" Max="40.000" Unit="mm"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalHeight" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpInjectValve" Level="Advanced" Description="Switch the inject valve to the specified position."&amp;gt;&amp;lt;Parameter Name="Position" Description="The position to switch the inject valve to." Optional="false" ByName="false" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Inject" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Load" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpSyringeValve" Level="Advanced" Description="Switch the syringe valve to the specified position."&amp;gt;&amp;lt;Parameter Name="Position" Description="The position to switch the syringe valve to." Optional="false" ByName="false" Type="enum" Min="0" Max="2" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="Needle" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Wash" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Waste" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpWaitInput" Level="Advanced" Description="Wait for the specified input to be in the given state."&amp;gt;&amp;lt;Parameter Name="Input" Description="Input to wait for to be in the given state." Optional="false" ByName="false" Type="enum" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="Inp1" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Inp2" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="Inp3" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Inp4" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="State" Description="State to wait for the given input to be in." Optional="false" ByName="false" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Low" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="High" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpOutput" Level="Advanced" Description="Set the specified output to the given state."&amp;gt;&amp;lt;Parameter Name="Output" Description="Output to set to the given state." Optional="false" ByName="false" Type="enum" Min="1" Max="4" Unit=""&amp;gt;&amp;lt;Enum-Value Value="1" Name="Out1" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="Out2" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="Out3" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="Out4" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="State" Description="State to set to the given output to." Optional="false" ByName="false" Type="bool"&amp;gt;&amp;lt;Enum-Value Value="1" Name="On" /&amp;gt;&amp;lt;Enum-Value Value="0" Name="Off" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpWaitStrokeSync" Level="Advanced" Description="Wait for syringe stroke. &amp;amp;#xD;&amp;amp;#xA;See also: SyncWithPump, PumpDevice." /&amp;gt;&amp;lt;Command Name="UdpInjectMarker" Level="Advanced" Description="Generate an &amp;amp;quot;inject&amp;amp;quot; marker pulse. Required in user-prog inject methods." /&amp;gt;&amp;lt;Command Name="UdpMoveSyringe" Level="Advanced" Description="Perform a syringe operation. &amp;amp;#xD;&amp;amp;#xA;The command requires either a Load parameter or an Unload parameter, but not both."&amp;gt;&amp;lt;Parameter Name="Load" Description="Volume to draw with this syringe operation. &amp;amp;#xD;&amp;amp;#xA;The MoveSyringe command requires either a Load parameter or an Unload parameter, but not both." Optional="true" ByName="false" Type="float" Digits="3" Min="0.000" Max="100.000" Unit="µl" /&amp;gt;&amp;lt;Parameter Name="Unload" Description="Volume to dispense with this syringe operation. &amp;amp;#xD;&amp;amp;#xA;The MoveSyringe command requires either a Load parameter or an Unload parameter, but not both." Optional="true" ByName="false" Type="float" Digits="3" Min="0.000" Max="100.000" Unit="µl" /&amp;gt;&amp;lt;Parameter Name="SyringeSpeed" Description="Syringe speed used when loading/unloading the syringe. &amp;amp;#xD;&amp;amp;#xA;DrawSpeed resp. DispSpeed is used if SyringeSpeed is not set explicitly." Optional="false" ByName="false" Type="float" Digits="3" Min="0.010" Max="33.333" Unit="µl/s"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalSpeed" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="UdpMoveSyringeHome" Level="Advanced" Description="Empty the syringe by moving it to its home position."&amp;gt;&amp;lt;Parameter Name="SyringeSpeed" Description="Syringe speed used when emptying the syringe. &amp;amp;#xD;&amp;amp;#xA;WasteSpeed is used if SyringeSpeed is not set explicitly." Optional="false" ByName="false" Type="float" Digits="3" Min="0.010" Max="33.333" Unit="µl/s"&amp;gt;&amp;lt;Enum-Value Value="-1" Name="GlobalSpeed" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="PrepareThisInjection" Level="Advanced" Description="Start inject procedure for current injection. &amp;amp;#xD;&amp;amp;#xA;Inject valve will be switched at next &amp;amp;quot;Inject&amp;amp;quot; command." /&amp;gt;&amp;lt;Command Name="PrepareNextInjection" Level="Advanced" Description="Start inject procedure for next injection (if there is one). &amp;amp;#xD;&amp;amp;#xA;Inject valve will be switched at next &amp;amp;quot;Inject&amp;amp;quot; command." /&amp;gt;&amp;lt;Command Name="InitiateChangeVial" Level="Normal" Description="Rotates the carousel so that the selected area is accessible for plate/vial exchange."&amp;gt;&amp;lt;Parameter Name="Tray" Description="Rotates the carousel so that the selected area is accessible for plate/vial exchange." Optional="false" ByName="false" Type="enum" Min="0" Max="5" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="BlueTray" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="BlueVials" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="GreenTray" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="GreenVials" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="RedTray" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="RedVials" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="InitiateChangeNeedle" Level="Expert" Description="Moves the needle so that it is accessible for exchange." /&amp;gt;&amp;lt;Command Name="cmd_maintain_s2_down" Level="Service" Description="This property shows internal information. Don't care about it." /&amp;gt;&amp;lt;Command Name="InitiateChangeSyringe" Level="Expert" Description="Initiate change syringe procedure." /&amp;gt;&amp;lt;Command Name="TerminateChangeSyringe" Level="Expert" Description="Terminate change syringe procedure." /&amp;gt;&amp;lt;Command Name="StopInject" Level="Normal" Description="Stops the running injection." /&amp;gt;&amp;lt;Command Name="InjectValveToInject" Level="Advanced" Description="Switches injection valve to inject position." /&amp;gt;&amp;lt;Command Name="InjectValveToLoad" Level="Advanced" Description="Switches injection valve to load position." /&amp;gt;&amp;lt;Property Name="SwitchInjectValveNumber" Level="Service" Description="Number of times to switch the inject valve during SmartStartup." Read-Only="false" Type="int" Min="1" Max="5" Unit="" Value="3" /&amp;gt;&amp;lt;Command Name="TestAlignment" Level="Service" Description="Tests whether the current alignment settings are plausible." /&amp;gt;&amp;lt;Command Name="RelaxMotors" Level="Service" Description="Relaxes all motors so that needle drive can be moved manually." /&amp;gt;&amp;lt;Command Name="MoveToAlign1" Level="Service" Description="Move needle over alignment point 1 (outer tray bore) &amp;amp;#xD;&amp;amp;#xA;as defined by the current setting of AlignX1 and AlignY1." /&amp;gt;&amp;lt;Property Name="AlignX1" Level="Service" Description="X motor position of alignment point 1 (outer tray bore)." Read-Only="false" Type="int" Min="-4750" Max="-3250" Unit="counts" Value="-3880" /&amp;gt;&amp;lt;Property Name="AlignY1" Level="Service" Description="Y motor position of alignment point 1 (outer tray bore)." Read-Only="false" Type="int" Min="-10000" Max="-4000" Unit="counts" Value="-7750" /&amp;gt;&amp;lt;Command Name="MoveToAlign2" Level="Service" Description="Move needle over alignment point 2 (inner tray bore) &amp;amp;#xD;&amp;amp;#xA;as defined by the current setting of AlignX2 and AlignY2." /&amp;gt;&amp;lt;Property Name="AlignX2" Level="Service" Description="X motor position of alignment point 2 (inner tray bore)." Read-Only="false" Type="int" Min="-750" Max="750" Unit="counts" Value="-109" /&amp;gt;&amp;lt;Property Name="AlignY2" Level="Service" Description="Y motor position of alignment point 2 (inner tray bore)." Read-Only="false" Type="int" Min="-3000" Max="3000" Unit="counts" Value="-791" /&amp;gt;&amp;lt;Command Name="MoveToAlignWash" Level="Service" Description="Move needle over alignment point (wash port)." /&amp;gt;&amp;lt;Property Name="AlignWash" Level="Service" Description="X motor position of alignment point (wash port)." Read-Only="false" Type="int" Min="-6500" Max="-5000" Unit="counts" Value="-5790" /&amp;gt;&amp;lt;Command Name="MoveToAlignNeedle" Level="Service" Description="Move needle down for height alignment. &amp;amp;#xD;&amp;amp;#xA;See also: AlignNeedle" /&amp;gt;&amp;lt;Property Name="AlignNeedle" Level="Service" Description="Target motor position for &amp;amp;quot;MoveToAlignNeedle&amp;amp;quot; command." Read-Only="false" Type="float" Digits="3" Min="-10.000" Max="10.000" Unit="mm" Value="400.000" /&amp;gt;&amp;lt;Command Name="MoveToAlignInjectPort" Level="Service" Description="Move needle for inject port alignment. &amp;amp;#xD;&amp;amp;#xA;See also: AlignInjectPort" /&amp;gt;&amp;lt;Property Name="AlignInjectPort" Level="Service" Description="Target motor position for &amp;amp;quot;MoveToAlignInjectPort&amp;amp;quot; command." Read-Only="false" Type="int" Min="-6500" Max="-5000" Unit="counts" Value="-5790" /&amp;gt;&amp;lt;Command Name="AcceptAlign" Level="Service" Description="Accept current position for alignment point." /&amp;gt;&amp;lt;Command Name="MoveNeedleDown" Level="Service" Description="Move needle down to a specified height. &amp;amp;#xD;&amp;amp;#xA;See also: NeedleHeight" /&amp;gt;&amp;lt;Property Name="NeedleHeight" Level="Service" Description="Target motor position for &amp;amp;quot;MoveNeedleDown&amp;amp;quot; command." Read-Only="false" Type="int" Min="0" Max="50" Unit="mm" Value="18" /&amp;gt;&amp;lt;Command Name="cmd_empty_drain" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_empty_wash" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="PurgePumpOff" Level="Expert" Description="Stops the purge pump." /&amp;gt;&amp;lt;Command Name="PurgePumpOn" Level="Expert" Description="Moves needle to wash port and draws mobile phase or air from the HPLC pump to reduce the pump priming time." /&amp;gt;&amp;lt;Command Name="WashBufferLoop" Level="Advanced" Description="Washes the buffer loop."&amp;gt;&amp;lt;Parameter Name="Volume" Description="Washes the buffer loop." Optional="true" ByName="false" Type="float" Digits="3" Min="0.000" Max="500.000" Unit="µl" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="FillWashPort" Level="Expert" Description="Fills the wash port."&amp;gt;&amp;lt;Parameter Name="Volume" Description="Fills the wash port." Optional="false" ByName="false" Type="float" Digits="3" Min="0.000" Max="5000.000" Unit="µl" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="WashSampleLoop" Level="Advanced" Description="Washes the sample loop."&amp;gt;&amp;lt;Parameter Name="Volume" Description="Washes the sample loop." Optional="false" ByName="false" Type="float" Digits="3" Min="0.000" Max="500.000" Unit="µl" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="cmd_sewage_pump" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="PrimeSyringe" Level="Advanced" Description="Primes the syringe by filling/emptying it 'PrimeSyringeNumber' times." /&amp;gt;&amp;lt;Property Name="PrimeSyringeNumber" Level="Advanced" Description="Number of times to fill/empty the syringe for a 'PrimeSyringe' operation." Read-Only="false" Type="int" Min="1" Max="100" Unit="" Value="1" /&amp;gt;&amp;lt;Command Name="cmd_goto_drain" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_moc_par" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version."&amp;gt;&amp;lt;Parameter Name="Value" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." Optional="false" ByName="false" Type="int" Min="0" Max="2147483648" Unit="" /&amp;gt;&amp;lt;Parameter Name="Param" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." Optional="false" ByName="false" Type="enum" Min="0" Max="8" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="mocp_go_p" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="mocp_go_i" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="mocp_go_d" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="mocp_hold_p" /&amp;gt;&amp;lt;Enum-Value Value="4" Name="mocp_hold_i" /&amp;gt;&amp;lt;Enum-Value Value="5" Name="mocp_hold_d" /&amp;gt;&amp;lt;Enum-Value Value="6" Name="mocp_pre_f0" /&amp;gt;&amp;lt;Enum-Value Value="7" Name="mocp_pre_f1" /&amp;gt;&amp;lt;Enum-Value Value="8" Name="mocp_pre_f2" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;Parameter Name="Addr" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." Optional="false" ByName="false" Type="enum" Min="0" Max="3" Unit=""&amp;gt;&amp;lt;Enum-Value Value="0" Name="MOC_ADR_TABLE" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="MOC_ADR_HOR" /&amp;gt;&amp;lt;Enum-Value Value="2" Name="MOC_ADR_NEEDLE" /&amp;gt;&amp;lt;Enum-Value Value="3" Name="MOC_ADR_SYRINGE" /&amp;gt;&amp;lt;/Parameter&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="cmd_moc_fw_download" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_finish_inject" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_prepare_inject" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_puncturer_home" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_dispense" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="cmd_draw" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="Wash" Level="Advanced" Description="Wash. &amp;amp;#xD;&amp;amp;#xA;See also: WashSpeed and WashVolume" /&amp;gt;&amp;lt;Command Name="cmd_inject_proc" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." /&amp;gt;&amp;lt;Command Name="CmdString" Level="Service" Description="This command allows to send arbitrary commands to the module's firmware. &amp;amp;#xD;&amp;amp;#xA;Refer to the firmware's interface specification for details."&amp;gt;&amp;lt;Parameter Name="Cmd" Description="The command to send to the module's firmware." Optional="false" ByName="false" Type="string" Max-Length="100" /&amp;gt;&amp;lt;/Command&amp;gt;&amp;lt;Command Name="SetFactoryDefaults" Level="Expert" Description="Sets internal parameters to factory defaults." /&amp;gt;&amp;lt;Command Name="ClearDisplayError" Level="Advanced" Description="Clears any error messages displayed on the module's display." /&amp;gt;&amp;lt;Property Name="EnableTrayTest" Level="Expert" Description="Shows whether the automatic tray test is enabled." Read-Only="false" Type="bool" Value="1"&amp;gt;&amp;lt;Enum-Value Value="0" Name="Disabled" /&amp;gt;&amp;lt;Enum-Value Value="1" Name="Enabled" /&amp;gt;&amp;lt;/Property&amp;gt;&amp;lt;Property Name="LoopDecompressionDelay" Level="Expert" Description="Time allowed for loop decompression." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="600.000" Unit="s" Value="0.000" /&amp;gt;&amp;lt;Property Name="FlushOutFactor" Level="Expert" Description="Flush out factor." Read-Only="false" Type="float" Digits="1" Min="1.0" Max="10.0" Unit="" Value="2.0" /&amp;gt;&amp;lt;Property Name="SeatCapillaryVolume" Level="Expert" Description="Seat capillary volume." Read-Only="false" Type="float" Digits="3" Min="0.000" Max="1000.000" Unit="µl" Value="3.100" /&amp;gt;&amp;lt;Property Name="prop_NeedleImpact" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." Read-Only="false" Type="int" Min="0" Max="30000" Unit="µm" Value="0" /&amp;gt;&amp;lt;Property Name="PunctureOffset" Level="Expert" Description="Specifies how far tray will be rotated in order to improve piercing of vial septa." Read-Only="false" Type="float" Digits="1" Min="0.0" Max="3.0" Unit="mm" Value="0.0" /&amp;gt;&amp;lt;Property Name="AutoTrayShakeTimes" Level="Expert" Description="Number of times the tray is automatically shaken prior to drawing the sample." Read-Only="false" Type="int" Min="0" Max="50" Unit="" Value="0" /&amp;gt;&amp;lt;Property Name="prop_BacklashVolume" Level="Service" Description="This property shows internal debugging information. &amp;amp;#xD;&amp;amp;#xA;Only available in the debug version." Read-Only="false" Type="int" Min="0" Max="800" Unit="nl" Value="0" /&amp;gt;&amp;lt;Property Name="Relay4Enabled" Level="Expert" Description="Controls whether relay 4 signals the inject response. If set to a duration, &amp;amp;#xD;&amp;amp;#xA;relay 4 will be active for this duration upon any in